      "source": [
        "def generate_user_utterance(conversation):\n",
        "    prompt = f\"Document: {document_text}\\nConversation:\\n{conversation}\\nUser:\"\n",
        "    inputs = falcon_tokenizer(prompt, return_tensors=\"pt\").to(device)\n",
        "    outputs = falcon_model.generate(\n",
        "        **inputs, max_new_tokens=40, pad_token_id=falcon_tokenizer.eos_token_id\n",
        "    )\n",
        "    return falcon_tokenizer.decode(outputs[0], skip_special_tokens=True).split(\"User:\")[-1].strip()\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "8cvAEpnRKOXc"
